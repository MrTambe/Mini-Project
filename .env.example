# Required: Convex deployment URL (set automatically by `npx convex dev`)
VITE_CONVEX_URL=your-deployment-url

# Required on the Convex deployment for Convex Auth (ES256 keypair)
# Generate with the @convex-dev/auth CLI or set manually - see README
JWT_PRIVATE_KEY=<pkcs8 PEM private key>
JWKS={"keys":[<public JWK with alg ES256>]}

# App settings on the Convex deployment
SITE_URL=http://localhost:5173
SEED_ADMIN_SECRET=<random-string, gates admin/demo-data seeding>

# Email OTP: Resend API key. Free tier can only send to your own email
RESEND_API_KEY=<from resend.com>

# Optional dev fallback: log OTP codes to the server console instead of email
# (only used when RESEND_API_KEY is not set)
DEV_CONSOLE_OTP=true

# --- Google Integrations (Sheets + Docs) ---
# Required for Google Sheets backup/sync (src/convex/googleSheets.ts)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-integration@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=<private key with real newlines>
GOOGLE_SHEETS_DB_ID=<spreadsheet ID of the user-owned "Eventure DB" sheet>

# Required for Google Docs export (src/convex/googleDocs.ts)
GOOGLE_DOCS_FOLDER_ID=<Google Drive folder ID where docs are created>

# Required for Google Calendar sync (src/convex/googleCalendar.ts)
GOOGLE_CALENDAR_ID=<calendar ID, e.g. college.edu_events@group.calendar.google.com>

# --- VLY Integrations (auto-set during project creation) ---
# VLY_INTEGRATION_KEY=sk_*
# VLY_INTEGRATION_BASE_URL=https://integrations.vly.ai/
